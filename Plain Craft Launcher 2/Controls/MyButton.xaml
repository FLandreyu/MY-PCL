<Border x:Class="MyButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}" x:Name="PanBack" Cursor="Hand"
             Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="{StaticResource ColorBrushSemiTransparent}">
    <Border CornerRadius="6" x:Name="PanFore" BorderThickness="1" BorderBrush="{DynamicResource ColorBrushSoftBorder}" RenderTransformOrigin="0.5,0.5" Background="{StaticResource ColorBrushSurface}">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <Grid RenderTransformOrigin="0.5,0.5">
            <Border CornerRadius="5" x:Name="PanShine" Opacity="0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#12FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="PanTextHost" Background="Transparent">
                <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None" HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource ColorBrush1}" FontSize="13" IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <ScaleTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Border>
